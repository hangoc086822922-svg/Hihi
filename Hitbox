local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

-- Biến cấu hình ban đầu
local hitboxEnabled = true
local hitboxSize = 10
local hitboxTransparency = 0.5
local espEnabled = true
local espColor = Color3.fromRGB(255, 255, 0)

-- Tạo Highlight ESP
local function createESP(character)
    if character:FindFirstChild("ESPHighlight") then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.FillColor = espColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Adornee = character
    highlight.Parent = character
end

local function removeESP(character)
    local highlight = character:FindFirstChild("ESPHighlight")
    if highlight then highlight:Destroy() end
end

-- Vòng lặp cập nhật ESP & Hitbox
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if rootPart and humanoid and humanoid.Health > 0 then
                    
                    -- Kiểm tra xem có phải là ĐỊCH không
                    local isEnemy = true
                    if player.Team and localPlayer.Team and player.Team == localPlayer.Team then
                        isEnemy = false -- Cùng Team là đồng đội
                    end

                    -- Chỉ chỉnh Hitbox thành hình tròn nếu là Địch và tính năng bật
                    if hitboxEnabled and isEnemy then
                        rootPart.Shape = Enum.PartType.Ball -- Đổi hình dạng thành hình tròn (hình cầu)
                        rootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        rootPart.Transparency = hitboxTransparency
                        rootPart.Color = Color3.fromRGB(255, 0, 0)
                        rootPart.Material = Enum.Material.Neon
                        rootPart.CanCollide = false
                    else
                        -- Đồng đội hoặc tắt hitbox sẽ trở về hình hộp chữ nhật gốc
                        rootPart.Shape = Enum.PartType.Block
                        rootPart.Size = Vector3.new(2, 2, 1)
                        rootPart.Transparency = 1
                    end
                    
                    if espEnabled then
                        createESP(character)
                    else
                        removeESP(character)
                    end
                else
                    removeESP(character)
                end
            end
        end
    end
end)

